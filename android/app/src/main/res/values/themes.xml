<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window chrome only. Everything visible is Compose.
         Transparent bars because the app draws edge to edge; the window
         background matches `ink` so there is no white flash between the
         splash and the first frame. -->
    <style name="Theme.XauRewards" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
