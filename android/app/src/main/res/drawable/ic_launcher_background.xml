<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: Xbox green lit from the top left, falling off
     to near-black, so the white nexus reads on every wallpaper. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="34" android:centerY="28"
                android:gradientRadius="110">
                <item android:offset="0" android:color="#FF3FD44B" />
                <item android:offset="0.45" android:color="#FF107C10" />
                <item android:offset="1" android:color="#FF04210A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
